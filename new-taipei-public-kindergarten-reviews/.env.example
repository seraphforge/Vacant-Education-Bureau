# New Taipei Public Kindergarten Google Review Intelligence Pipeline
# Copy this file to .env and fill in your values.

# Google Places API (New) key
# Required for: match-places, fetch-reviews
# How to get: https://console.cloud.google.com/apis/credentials
GOOGLE_MAPS_API_KEY=

# Database URL (default: SQLite in data/kindergarten_reviews.db)
# To switch to PostgreSQL: postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=

# Rate limiting
GOOGLE_REQUEST_DELAY=0.5
GOOGLE_MAX_RETRIES=5
GOOGLE_TIMEOUT=30

# Logging
LOG_LEVEL=INFO
