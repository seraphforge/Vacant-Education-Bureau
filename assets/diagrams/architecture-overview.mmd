%%{init: {"theme":"base","themeVariables":{"fontFamily":"Noto Sans CJK TC, Microsoft JhengHei, sans-serif","fontSize":"20px","lineColor":"#37474f","primaryBorderColor":"#37474f"}}}%%
flowchart LR
    classDef user fill:#eceff1,stroke:#546e7a,stroke-width:2px,color:#212121;
    classDef edge fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px,color:#1b5e20;
    classDef core fill:#e3f2fd,stroke:#1565c0,stroke-width:2px,color:#0d47a1;
    classDef data fill:#fff3e0,stroke:#e65100,stroke-width:2px,color:#e65100;
    classDef ai fill:#f3e5f5,stroke:#6a1b9a,stroke-width:2px,color:#4a148c;

    subgraph USERS[使用者端]
        direction TB
        PARENT["一般家長 / 民眾"]:::user
        STAFF["政府承辦人員"]:::user
        WEB["Angular Web 應用程式"]:::user
    end

    subgraph PLATFORM[AWS Serverless 平台 &nbsp;·&nbsp; Region us-east-1]
        direction TB
        CF["Amazon CloudFront + S3<br/><b>Angular 前端網站</b>"]:::edge
        COG["Amazon Cognito<br/><b>政府登入與縣市權限</b>"]:::edge
        APIGW["Amazon API Gateway<br/><b>統一 API 入口</b>"]:::core
        LAMBDA["AWS Lambda<br/><b>查詢 · 回報 · 後台邏輯</b>"]:::core
        WORKER["輿情分析 Worker<br/><b>AWS Lambda · 非同步</b>"]:::core
    end

    subgraph BACKEND[資料與 AI 服務]
        direction TB
        RDS["Amazon RDS for MySQL<br/><b>平台主要資料庫</b>"]:::data
        SES["Amazon SES<br/><b>Email 驗證碼</b>"]:::data
        S3A["Amazon S3<br/><b>家長回報附件</b>"]:::data
        AI["公開網路資訊 + Amazon Bedrock + Amazon Comprehend<br/><b>蒐集 · AI 摘要 · 情緒分析</b>"]:::ai
    end

    PARENT --> WEB
    STAFF --> WEB
    WEB -->|載入 Angular 網站| CF
    WEB -->|HTTPS API| APIGW

    STAFF -.->|登入 / 取得 ID Token| COG
    COG -. JWT 驗證依據 .-> APIGW
    WEB -->|Bearer ID Token| APIGW

    APIGW --> LAMBDA
    LAMBDA --> RDS
    LAMBDA -->|寄送| SES
    PARENT -->|預簽網址直接上傳| S3A
    LAMBDA -->|非同步啟動| WORKER
    WORKER --> AI
    WORKER -->|儲存分析結果| RDS
